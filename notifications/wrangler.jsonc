{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "name": "gibbs-td-alerts",
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "vars": {
    "ALERTS_ENABLED": "false",
    "ALERTS_START_AT": "",
    "MAX_ALERTS_PER_MONTH": "1000",
    "MAX_SUBSCRIBERS": "100",
    "MAX_WEB_SIGNUPS_PER_DAY": "100",
    "PUBLIC_URL": "",
    "SIGNUPS_ENABLED": "false",
    "SIGNUP_MODE": "waitlist",
    "SITE_ORIGIN": "https://gibbstouchdowns.com",
    "SUPPORT_EMAIL": "ssh.b.designs@gmail.com",
    "TWILIO_PHONE_NUMBER": ""
  }
}
