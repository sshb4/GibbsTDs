{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "name": "gibbs-td-alerts",
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "vars": {
    "DONATION_URL": "https://ko-fi.com/clipboardstats",
    "ALERTS_ENABLED": "false",
    "ALERTS_START_AT": "",
    "MAX_ALERTS_PER_MONTH": "1000",
    "MAX_SUBSCRIBERS": "100",
    "MAX_WEB_SIGNUPS_PER_DAY": "100",
    "PUBLIC_URL": "https://gibbs-td-alerts.sashacbates.workers.dev",
    "SIGNUPS_ENABLED": "true",
    "SIGNUP_MODE": "sms",
    "SITE_ORIGIN": "https://gibbstouchdowns.com",
    "SUPPORT_EMAIL": "sashacbates@gmail.com",
    "TWILIO_PHONE_NUMBER": "+18883132426"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gibbs-td-alerts-db",
      "database_id": "120d11ff-14d5-4534-a745-a6602339ce6c",
      "remote": true
    }
  ]
}
